# syntax=docker/dockerfile:1
#
# Caddy with a DNS-challenge plugin compiled in. Stock Caddy can only do the HTTP and
# TLS-ALPN challenges, which need port 80/443 reachable from the public internet — no
# use for a relay whose DNS record points at a LAN address. The DNS challenge proves
# ownership through the provider's API instead, so it works with no inbound ports at all.
#
# Swap the plugin for your DNS provider if you don't use Cloudflare — the list is at
# https://github.com/caddy-dns — and change the matching credential in Caddyfile.domain.

FROM caddy:2-builder AS build
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=build /usr/bin/caddy /usr/bin/caddy
