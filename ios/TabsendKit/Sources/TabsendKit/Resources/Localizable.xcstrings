      }
    },
    "Your relay no longer has this group. Pair this phone again if you still have access." : {
      "comment" : "Explanation after a request failed: the group was deleted on the relay. Pairing again means joining with a new setup link. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat diese Gruppe nicht mehr. Koppele dieses Smartphone erneut, falls du noch Zugriff hast."
          }
        },
