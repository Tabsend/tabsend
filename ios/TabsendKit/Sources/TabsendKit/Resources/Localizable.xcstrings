    },
    "Soon, every device is removed, this one too." : {
      "comment" : "Second sentence of the reset card when the time of the reset is not known.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald werden alle Geräte entfernt, auch dieses."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soon, every device is removed, this one too."
          }
        }
      }
    },
    "Start fresh on %@?" : {
      "comment" : "Title of the confirmation dialog before switching to a different relay. %@ is the relay address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@ neu anfangen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fresh on %@?"
          }
        }
      }
    },
    "Stop the reset" : {
      "comment" : "Button on the reset card. Stops the waiting reset for every device. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurücksetzen stoppen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop the reset"
          }
        }
      }
    },
    "Switch to this address" : {
      "comment" : "Button on the move-to-another-relay sheet, shown when the address is the same relay. It switches the app to the new address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu dieser Adresse wechseln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to this address"
          }
        }
      }
    },
    "Switch to this relay" : {
      "comment" : "Destructive button on the move-to-another-relay sheet and in its confirmation dialog, shown when the address is a different relay.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu diesem Relay wechseln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to this relay"
          }
        }
      }
    },
    "Tabsend holds at most %lld tabs while your relay isn't taking them, and this one was the oldest. Send it again once the relay is answering." : {
      "comment" : "Explanation under a failed send: too many tabs were waiting and this, the oldest, was dropped. %lld is the most tabs kept, such as 200. The relay is the server.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tabsend hält höchstens %lld Tab zurück, solange dein Relay ihn nicht annimmt. Dieser war der älteste. Sende ihn erneut, sobald das Relay antwortet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tabsend hält höchstens %lld Tabs zurück, solange dein Relay sie nicht annimmt. Dieser war der älteste. Sende ihn erneut, sobald das Relay antwortet."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tabsend holds at most %lld tab while your relay isn't taking it, and this one was the oldest. Send it again once the relay is answering."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tabsend holds at most %lld tabs while your relay isn't taking them, and this one was the oldest. Send it again once the relay is answering."
                }
              }
            }
          }
        }
      }
    },
    "Tabsend service" : {
      "comment" : "Heading of the small group on the home screen that shows the free trial. \"Tabsend service\" is Tabsend's own hosted server, as opposed to a server the person runs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabsend-Dienst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabsend service"
          }
        }
      }
    },
    "That address didn't answer like a Tabsend relay. Check it and try again." : {
      "comment" : "Explanation when the address typed or pasted does not lead to a Tabsend relay (the server that passes tabs between devices).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse hat nicht wie ein Tabsend-Relay geantwortet. Prüfe sie und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That address didn't answer like a Tabsend relay. Check it and try again."
          }
        }
      }
    },
    "That pairing code is no longer valid." : {
      "comment" : "Explanation under a failed request: the pairing code was used, expired or unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kopplungscode ist nicht mehr gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That pairing code is no longer valid."
          }
        }
      }
    },
    "That relay is running an older version of Tabsend than this app (relay speaks v%lld, app needs v%lld). Update the relay, then pair again." : {
      "comment" : "Error when pairing: the relay is older than this app can talk to. The two numbers are protocol versions, not counts: \"v1\", \"v2\". The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Relay läuft eine ältere Tabsend-Version, als diese App braucht (Relay nutzt v%1$lld, App braucht v%2$lld). Aktualisiere das Relay und koppele dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That relay is running an older version of Tabsend than this app (relay speaks v%1$lld, app needs v%2$lld). Update the relay, then pair again."
          }
        }
      }
    },
    "That setup link is unknown, expired, or already used." : {
      "comment" : "Banner on the first-run screen when the relay refuses the pairing code in the setup link.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Einrichtungslink ist unbekannt, abgelaufen oder wurde schon verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That setup link is unknown, expired, or already used."
          }
        }
      }
    },
    "The device it was for" : {
      "comment" : "Stands in for a device's name when the name is unknown. It starts a sentence: \"%@ was removed from your group.\", \"%@ is no longer in your group.\" (and the notification versions, which end \"...send it to another device.\"). A language with cases or genders may need those sentences reworded when this phrase is used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zielgerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device it was for"
          }
        }
      }
    },
    "The device they were for" : {
      "comment" : "Stands in for a device's name when the name is unknown and several tabs were waiting for it. It starts a sentence: \"%@ was removed from your group. Open Tabsend to send them to another device.\" A language with cases or genders may need that sentence reworded when this phrase is used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zielgerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device they were for"
          }
        }
      }
    },
    "The device you paired with didn't list it. If it isn't yours, remove it in Tabsend." : {
      "comment" : "Notification body on a fresh pairing: one device is in the group that the device you paired with did not mention. \"It\" is the device named in the title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät, mit dem du gekoppelt hast, hat es nicht aufgelistet. Wenn es nicht deins ist, entferne es in Tabsend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device you paired with didn't list it. If it isn't yours, remove it in Tabsend."
          }
        }
      }
    },
    "The keys on %@ have changed since this phone last saw them. Open Tabsend once to pick up the new ones, then send again." : {
      "comment" : "Explanation under a failed send: the receiving device has new encryption keys. %@ is the device name, or \"that device\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat neue Schlüssel, seit dieses Smartphone sie zuletzt gesehen hat. Öffne Tabsend einmal, um die neuen Schlüssel zu holen, und sende dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keys on %@ have changed since this phone last saw them. Open Tabsend once to pick up the new ones, then send again."
          }
        }
      }
    },
    "The relay refused the check: %@" : {
      "comment" : "Result on the move-to-another-relay sheet when the relay answered with an error. %@ is a full sentence saying why, such as \"Your relay is busy right now. Give it a moment and try again.\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay hat die Prüfung abgelehnt: %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay refused the check: %@"
          }
        }
      }
    },
    "There's no link in what you shared." : {
      "comment" : "Message in the share sheet when the shared item contains no web address that could be sent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dem, was du geteilt hast, ist kein Link."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no link in what you shared."
          }
        }
      }
    },
    "This address only works on your home network. Away from home or on mobile data? Connect to your home Wi-Fi or turn on your VPN." : {
      "comment" : "Sentence added after the \"can't reach your relay\" notice when the relay address is a home-network address. Shown on the home screen banner and in notifications.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse funktioniert nur in deinem Heimnetz. Unterwegs oder mit mobilen Daten? Verbinde dich mit deinem WLAN zu Hause oder schalte dein VPN ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This address only works on your home network. Away from home or on mobile data? Connect to your home Wi-Fi or turn on your VPN."
          }
        }
      }
    },
    "This group already has the most unused pairing links it allows. Try again in a few minutes, when the oldest one expires." : {
      "comment" : "Explanation when making a new pairing link failed: too many links are waiting to be used, and each expires by itself after a few minutes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe hat bereits die höchste erlaubte Zahl an ungenutzten Kopplungslinks. Versuche es in ein paar Minuten erneut, wenn der älteste abläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group already has the most unused pairing links it allows. Try again in a few minutes, when the oldest one expires."
          }
        }
      }
    },
    "This is a different relay. It doesn't know your devices, so each one will need to pair again." : {
      "comment" : "Result on the move-to-another-relay sheet: the address is a different relay, so every device has to be paired again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein anderes Relay. Es kennt deine Geräte nicht, deshalb muss jedes erneut gekoppelt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a different relay. It doesn't know your devices, so each one will need to pair again."
          }
        }
      }
    },
    "This phone leaves its current device group. Every device you want to keep has to pair again on the new relay." : {
      "comment" : "Body of the confirmation dialog before switching to a different relay. The device group is the set of devices that send tabs to each other.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Smartphone verlässt seine aktuelle Gerätegruppe. Jedes Gerät, das du behalten willst, muss auf dem neuen Relay erneut gekoppelt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone leaves its current device group. Every device you want to keep has to pair again on the new relay."
          }
        }
      }
    },
    "This phone · Paused" : {
      "comment" : "Second line of this phone's own row in \"Your devices\" after the free trial ended and sending is paused. A dot separates the two parts. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Smartphone · Pausiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone · Paused"
          }
        }
      }
    },
    "This tab waited %lld days for your relay and was never taken, so Tabsend has stopped holding it. Send it again once the relay is answering." : {
      "comment" : "Explanation under a failed send: the tab waited too long for the relay and was dropped. %lld is the number of days, such as 7. The relay is the server.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieser Tab hat %lld Tag auf dein Relay gewartet und wurde nie angenommen. Deshalb hält Tabsend ihn nicht mehr zurück. Sende ihn erneut, sobald das Relay antwortet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieser Tab hat %lld Tage auf dein Relay gewartet und wurde nie angenommen. Deshalb hält Tabsend ihn nicht mehr zurück. Sende ihn erneut, sobald das Relay antwortet."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This tab waited %lld day for your relay and was never taken, so Tabsend has stopped holding it. Send it again once the relay is answering."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This tab waited %lld days for your relay and was never taken, so Tabsend has stopped holding it. Send it again once the relay is answering."
                }
              }
            }
          }
        }
      }
    },
    "This version of the Tabsend app is too old for that relay (app speaks v%lld, relay needs v%lld). Install the latest build, then pair again." : {
      "comment" : "Error when pairing: the app is older than the relay allows. The two numbers are protocol versions, not counts: \"v1\", \"v2\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version der Tabsend-App ist zu alt für dieses Relay (App nutzt v%1$lld, Relay braucht v%2$lld). Installiere die neueste Version und koppele dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of the Tabsend app is too old for that relay (app speaks v%1$lld, relay needs v%2$lld). Install the latest build, then pair again."
          }
        }
      }
    },
    "Until %@" : {
      "comment" : "Value on the right of the \"Free trial\" row. %@ is the date the trial ends, such as \"Nov 18\". Keep it short.",
