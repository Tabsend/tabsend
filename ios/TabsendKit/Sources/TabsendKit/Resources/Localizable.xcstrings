        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection. Will send when you're back online"
          }
        }
      }
    },
    "No devices yet. Pair one to start sending" : {
      "comment" : "Share-sheet message when no other device has joined the group yet. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Geräte. Koppele eines, um zu senden"
