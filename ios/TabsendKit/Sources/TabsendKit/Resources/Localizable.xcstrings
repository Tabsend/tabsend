        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New from %@"
          }
        }
      }
    },
    "Newest first, every device in your group. The last %lld are kept on this phone." : {
      "comment" : "Footnote under the history list when the relay keeps the group's history. %lld is how many tabs this phone keeps, such as 50.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Neueste zuerst, alle Geräte in deiner Gruppe. Auf diesem Smartphone bleibt %lld Tab gespeichert."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
