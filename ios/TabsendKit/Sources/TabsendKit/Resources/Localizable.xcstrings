          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered"
          }
        }
      }
    },
    "Dismiss" : {
      "comment" : "Button on the card about a device that joined and then disappeared from the list. Hides the card on this phone. Keep it short.",
