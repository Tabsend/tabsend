            "state" : "translated",
            "value" : "unknown"
          }
        }
      }
    },
    "your device" : {
      "comment" : "Stands in for a device's name when the name is unknown. It sits inside the headlines \"Sent to %@\", \"Waiting to send to %@\" and \"Couldn't send to %@\". A language with cases or genders may need those headlines reworded when this phrase is used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dein Gerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your device"
          }
        }
      }
    },
    "“%@” is waiting for a new device" : {
      "comment" : "Notification title: one waiting tab has no device to go to. %@ is the title of the page, in curly quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
