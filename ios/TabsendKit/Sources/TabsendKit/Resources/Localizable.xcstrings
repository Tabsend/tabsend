          }
        }
      }
    },
    "%lld of %lld tabs" : {
      "comment" : "Heading of a block of tabs that were sent together, when only some are listed. The first %lld is how many are listed, the second is how many were sent, such as \"2 of 3 tabs\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %#@tabs@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %#@tabs@"
          },
          "substitutions" : {
            "tabs" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg tab"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg tabs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
