    },
    "New from %@" : {
      "comment" : "First line of a large card on Home and History: a tab that arrived and has not been opened. %@ is the sending device's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu von %1$@"
