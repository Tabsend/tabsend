        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab ohne Titel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untitled tab"
          }
        }
      }
    },
    "Waiting for %@" : {
      "comment" : "State of a tab this phone sent: the relay holds it until the receiving device picks it up. %@ is the device name, or \"that device\" when unknown. Short: it sits beside an icon.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for %@"
          }
        }
      }
    },
    "Waiting to send to %@" : {
      "comment" : "Headline of a toast or notification: the tab could not be sent yet and will go by itself. %@ is the name of the receiving device. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird später an %1$@ gesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting to send to %@"
          }
        }
      }
    },
    "We email you before it ends." : {
      "comment" : "Small note under the \"Free trial\" row on the home screen. \"It\" is the free trial; the email is sent three days before.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir schreiben dir per E-Mail, bevor sie endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We email you before it ends."
          }
        }
      }
    },
    "Where is your relay now?" : {
      "comment" : "Heading above the address field on the move-to-another-relay sheet. The relay is the server that passes tabs between devices.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist dein Relay jetzt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is your relay now?"
          }
        }
      }
    },
    "You're offline. This tab sends itself as soon as you're back." : {
      "comment" : "Explanation under a failed or waiting send: this phone has no internet connection. The tab is kept and sent later.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Dieser Tab wird automatisch gesendet, sobald du wieder online bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. This tab sends itself as soon as you're back."
          }
        }
      }
    },
    "Your account is ready, and your 14-day free trial has started." : {
      "comment" : "Notice above the \"Name this phone\" screen, right after the account was made. Used when the end date of the trial is not known.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ist bereit, und deine 14-tägige kostenlose Testphase hat begonnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is ready, and your 14-day free trial has started."
          }
        }
      }
    },
    "Your account is ready, and your 14-day free trial has started. It runs until %@." : {
      "comment" : "Notice above the \"Name this phone\" screen, right after the account was made. %@ is the date the trial ends, such as \"Nov 18\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ist bereit, und deine 14-tägige kostenlose Testphase hat begonnen. Sie läuft bis %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is ready, and your 14-day free trial has started. It runs until %@."
          }
        }
      }
    },
    "Your free trial has ended" : {
      "comment" : "Heading of the amber card at the top of the home screen after the free trial ended.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine kostenlose Testphase ist zu Ende"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your free trial has ended"
          }
        }
      }
    },
    "Your relay already hosts a group of devices." : {
      "comment" : "Explanation under a failed request: the relay already has a device group and allows only one. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay verwaltet bereits eine Gruppe von Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay already hosts a group of devices."
          }
        }
      }
    },
    "Your relay couldn't find %@." : {
      "comment" : "Explanation under a failed send: the relay has no such device. %@ is the device name, or \"that device\". The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat %1$@ nicht gefunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay couldn't find %@."
          }
        }
      }
    },
    "Your relay couldn't find that device. It may already be gone." : {
      "comment" : "Explanation after renaming or removing a device failed: the relay has no such device in the group. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat dieses Gerät nicht gefunden. Möglicherweise ist es schon weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay couldn't find that device. It may already be gone."
          }
        }
      }
    },
    "Your relay didn't understand that. It's most likely running an older version than this phone. Updating it should fix this." : {
      "comment" : "Explanation after a request failed: the relay could not read what the phone sent. The relay is the server, probably out of date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat das nicht verstanden. Wahrscheinlich läuft darauf eine ältere Version als auf diesem Smartphone. Ein Update sollte das beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay didn't understand that. It's most likely running an older version than this phone. Updating it should fix this."
          }
        }
      }
    },
    "Your relay didn't understand this send. It's most likely running an older version than this phone. Updating it should fix this." : {
      "comment" : "Explanation under a failed send: the relay could not read the request. The relay is the server, probably out of date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat diesen Versand nicht verstanden. Wahrscheinlich läuft darauf eine ältere Version als auf diesem Smartphone. Ein Update sollte das beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay didn't understand this send. It's most likely running an older version than this phone. Updating it should fix this."
          }
        }
      }
    },
    "Your relay doesn't know %@ any more. Pair it again, then send this tab a second time." : {
      "comment" : "Explanation under a failed send: the relay no longer knows the receiving device. %@ is the device name, or \"that device\". The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay kennt %1$@ nicht mehr. Koppele es erneut und sende diesen Tab dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay doesn't know %@ any more. Pair it again, then send this tab a second time."
          }
        }
      }
    },
    "Your relay doesn't recognise this phone any more. Set Tabsend up again here to start sending." : {
      "comment" : "Explanation under a failed send: the relay does not accept this phone's credentials. Setting up again means pairing again. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
