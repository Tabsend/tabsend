{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Nothing was changed." : {
      "comment" : "Message on the move-to-another-relay sheet when switching failed. %@ is the reason, a full sentence. Nothing was changed: the app still uses the old relay.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Es wurde nichts geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nothing was changed."
          }
        }
      }
    },
    "%@ is in your group" : {
      "comment" : "Notification title on a fresh pairing: one device was already in the group and the pairing link did not vouch for it. %@ is the device name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist in deiner Gruppe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is in your group"
          }
        }
      }
    },
    "%@ is no longer in your group." : {
      "comment" : "Line under a waiting tab whose receiving device is no longer in the group, as the relay reports it. %@ is the device name, or \"The device it was for\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht mehr in deiner Gruppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is no longer in your group."
          }
        }
      }
    },
    "%@ is no longer in your group. Open Tabsend to send it to another device." : {
      "comment" : "Notification body for one waiting tab whose device is no longer in the group, as the relay reports it. %@ is the device name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht mehr in deiner Gruppe. Öffne Tabsend, um den Tab an ein anderes Gerät zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is no longer in your group. Open Tabsend to send it to another device."
          }
        }
      }
    },
    "%@ is no longer in your group. Open Tabsend to send them to another device." : {
      "comment" : "Notification body for several waiting tabs whose device is no longer in the group, as the relay reports it. %@ is the device name. \"them\" means the tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht mehr in deiner Gruppe. Öffne Tabsend, um sie an ein anderes Gerät zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is no longer in your group. Open Tabsend to send them to another device."
          }
        }
      }
    },
    "%@ joined your Tabsend devices. If any wasn't you, remove it in Tabsend." : {
      "comment" : "Notification body: several new devices joined. %@ is the list of device names, such as \"Pixel 9, Home Firefox and Work laptop\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sind zu deinen Tabsend-Geräten hinzugekommen. Wenn du eines davon nicht hinzugefügt hast, entferne es in Tabsend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ joined your Tabsend devices. If any wasn't you, remove it in Tabsend."
          }
        }
      }
    },
    "%@ joined, then disappeared" : {
      "comment" : "Heading of a card on the home screen. A device joined the group and later vanished from the device list without being removed here. %@ is the device name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist beigetreten und wieder verschwunden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ joined, then disappeared"
          }
        }
      }
    },
    "%@ never picked it up, and the relay has stopped holding it. Open Tabsend to send it again." : {
      "comment" : "Notification body for one tab that never arrived. %@ is the receiving device's name, or \"that device\" when unknown. \"It\" is the tab. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat ihn nie abgeholt, und das Relay hält ihn nicht mehr zurück. Öffne Tabsend, um ihn erneut zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ never picked it up, and the relay has stopped holding it. Open Tabsend to send it again."
          }
        }
      }
    },
    "%@ was added" : {
      "comment" : "Notification title: one new device joined the group. %@ is the device name, such as \"Pixel 9\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde hinzugefügt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was added"
          }
        }
      }
    },
    "%@ was removed from your group." : {
      "comment" : "Line under a waiting tab whose receiving device was removed from the group on this phone. %@ is the device name, or \"The device it was for\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde aus deiner Gruppe entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed from your group."
          }
        }
      }
    },
    "%@ was removed from your group. Open Tabsend to send it to another device." : {
      "comment" : "Notification body for one waiting tab whose device this phone removed. %@ is the device name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde aus deiner Gruppe entfernt. Öffne Tabsend, um den Tab an ein anderes Gerät zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed from your group. Open Tabsend to send it to another device."
          }
        }
      }
    },
    "%@ was removed from your group. Open Tabsend to send them to another device." : {
      "comment" : "Notification body for several waiting tabs whose device this phone removed. %@ is the device name. \"them\" means the tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde aus deiner Gruppe entfernt. Öffne Tabsend, um sie an ein anderes Gerät zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed from your group. Open Tabsend to send them to another device."
          }
        }
      }
    },
    "%@ · %@ · %@" : {
      "comment" : "Second line of a history row. The first %@ is the website, the second is who moved the tab (such as \"from Work laptop\"), the third is how long ago (such as \"3m ago\"). The dots separate the three.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "%@ · Paused" : {
      "comment" : "Second line of another device's row in \"Your devices\" after the free trial ended and sending is paused. %@ is the kind of device, such as \"Chrome\" or \"Android phone\". A dot separates the two parts. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Pausiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Paused"
          }
        }
      }
    },
    "%@ → %@" : {
      "comment" : "Part of a history row for a tab moved between two other devices. The first %@ is the sending device, the second is the receiving device. The arrow points from sender to receiver.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@"
          }
        }
      }
    },
    "%@. The device you paired with didn't list them. If any isn't yours, remove it in Tabsend." : {
      "comment" : "Notification body on a fresh pairing: several devices are in the group that the device you paired with did not mention. %@ is the list of device names, such as \"Pixel 9, Home Firefox and Work laptop\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. Das Gerät, mit dem du gekoppelt hast, hat sie nicht aufgelistet. Wenn eines nicht deins ist, entferne es in Tabsend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. The device you paired with didn't list them. If any isn't yours, remove it in Tabsend."
          }
        }
      }
    },
    "%lld devices are in your group" : {
      "comment" : "Notification title on a fresh pairing: several devices were already in the group and the pairing link did not vouch for them. %lld is how many. The singular form is for completeness: one device uses the named title.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Gerät ist in deiner Gruppe"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Geräte sind in deiner Gruppe"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld device is in your group"
