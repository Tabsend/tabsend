        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending is paused. We emailed you what to do next."
          }
        }
      }
    },
    "Sent %lld tabs that were waiting" : {
      "comment" : "Notification title: tabs that were waiting have been sent. %lld is how many. The singular form is used when there is one tab and no title to show.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der wartende Tab wurde gesendet"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
