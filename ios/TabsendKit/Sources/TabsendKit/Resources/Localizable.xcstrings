      }
    },
    "Someone asked to remove all your devices" : {
      "comment" : "Heading of the red card at the top of the home screen when a reset of the whole device group is waiting. May wrap onto two lines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat darum gebeten, alle deine Geräte zu entfernen"
