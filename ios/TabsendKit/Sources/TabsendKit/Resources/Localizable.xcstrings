                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Couldn't send %lld tabs that were waiting"
                }
              }
            }
          }
        }
      }
    },
    "Couldn't send to %@" : {
      "comment" : "Headline of a toast or notification: the tab could not be sent. %@ is the name of the receiving device. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden an %1$@ fehlgeschlagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't send to %@"
          }
        }
      }
    },
    "Couldn't send. Check Tabsend is still linked" : {
      "comment" : "Generic share-sheet failure when the send could not be completed. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden fehlgeschlagen. Prüfe, ob Tabsend noch gekoppelt ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't send. Check Tabsend is still linked"
          }
        }
      }
    },
    "Delivered" : {
      "comment" : "State of a tab this phone sent: the receiving device confirmed it. Short: it sits beside an icon.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
