            "state" : "translated",
            "value" : "Your relay doesn't recognise this phone any more. Set Tabsend up again here to start sending."
          }
        }
      }
    },
    "Your relay has reached a limit for your group." : {
      "comment" : "Explanation after a request failed: some limit for this group was reached on the relay. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat für deine Gruppe ein Limit erreicht."
          }
