                  "value" : "%lld tabs never arrived"
                }
              }
            }
          }
        }
      }
    },
    "%lld tabs waiting on this phone" : {
      "comment" : "Heading of the list of tabs still on this phone because the relay has not taken them. %lld is how many. The singular form drops the number.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wartet auf diesem Smartphone"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Tabs warten auf diesem Smartphone"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Waiting on this phone"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tabs waiting on this phone"
                }
              }
            }
          }
        }
      }
    },
    "A tab this phone can't read" : {
      "comment" : "Title of a history row for a tab that arrived sealed with a group key this phone does not have, so its title and address are unreadable.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tab, den dieses Smartphone nicht lesen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tab this phone can't read"
          }
        }
      }
    },
    "Can't reach your relay at %@. It last answered %@, and sends are being held until it's back." : {
      "comment" : "Standing notice on the home screen: the relay (the server that passes tabs between devices) is not answering. The first %@ is the relay address, the second is how long ago it last answered, such as \"5m ago\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay unter %1$@ antwortet nicht. Letzte Antwort: %2$@. Gesendete Tabs warten, bis es wieder antwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach your relay at %1$@. It last answered %2$@, and sends are being held until it's back."
          }
        }
      }
    },
    "Can't reach your relay at %@. The tab is held here and sends itself once the relay answers again." : {
      "comment" : "Explanation under a waiting send: the relay (the server that passes tabs between devices) did not answer. %@ is the relay address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay unter %1$@ antwortet nicht. Der Tab bleibt hier und wird automatisch gesendet, sobald das Relay wieder antwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach your relay at %@. The tab is held here and sends itself once the relay answers again."
          }
        }
      }
    },
    "Check" : {
      "comment" : "Button on the move-to-another-relay sheet that checks the address typed in the field. Keep it to one word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check"
          }
        }
      }
    },
    "Checking…" : {
      "comment" : "Status line on the move-to-another-relay sheet while the address is being checked.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird geprüft…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking…"
          }
        }
      }
    },
    "Couldn't reach %@. Check the address and that it's running." : {
      "comment" : "Result on the move-to-another-relay sheet when the relay did not answer. %@ is the address that was checked.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht erreichbar. Prüfe die Adresse und ob das Relay läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach %@. Check the address and that it's running."
          }
        }
      }
    },
    "Couldn't send %lld tabs that were waiting" : {
      "comment" : "Notification title: tabs that were waiting could not be sent and were dropped. %lld is how many. The singular form reads \"Couldn't send a tab that was waiting\".",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
