        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "recently"
          }
        }
      }
    },
    "sealed with a group key this phone doesn't have" : {
      "comment" : "Second line of a history row for a tab this phone cannot read, in place of the website. Group key: the shared key that unlocks history.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mit einem Gruppenschlüssel verschlüsselt, den dieses Smartphone nicht hat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sealed with a group key this phone doesn't have"
          }
        }
      }
    },
    "that device" : {
      "comment" : "Stands in for a device's name when the name is unknown. It sits inside a sentence, where %@ is a device name: \"Your relay couldn't find %@.\", \"Waiting for %@\", \"%@ never picked it up...\". Not capitalized: it never starts a sentence. A language with cases or genders may need those sentences reworded when this phrase is used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dieses Gerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "that device"
          }
        }
      }
    },
    "to %@" : {
      "comment" : "Part of a history row: this phone sent the tab. %@ is the name of the receiving device, such as \"Work laptop\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "an %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "to %@"
          }
        }
      }
    },
    "unknown" : {
      "comment" : "Age of something whose time cannot be read. Short: it sits in a row of small print.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "unbekannt"
