        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone asked to remove all your devices"
          }
        }
      }
    },
    "Someone asked to remove all your devices on %@. Open Tabsend to stop it." : {
      "comment" : "Notification body when a reset of the whole device group is waiting. %@ is the date the reset was asked for, such as \"October 27\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat am %1$@ darum gebeten, alle deine Geräte zu entfernen. Öffne Tabsend, um das zu stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone asked to remove all your devices on %@. Open Tabsend to stop it."
          }
        }
      }
    },
    "Someone asked to remove all your devices. Open Tabsend to stop it." : {
      "comment" : "Notification body when a reset of the whole device group is waiting and the date of the request is not known.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat darum gebeten, alle deine Geräte zu entfernen. Öffne Tabsend, um das zu stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
