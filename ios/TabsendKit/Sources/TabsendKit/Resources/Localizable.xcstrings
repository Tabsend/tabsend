    },
    "Move to another relay…" : {
      "comment" : "Settings row on the home screen that opens the move-to-another-relay sheet. Ends with an ellipsis because it opens a sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu einem anderen Relay wechseln…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to another relay…"
          }
        }
      }
    },
    "Never arrived" : {
      "comment" : "State of a tab this phone sent: the relay stopped holding it and the receiving device never picked it up. Short: it sits beside an icon and a Send again button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie angekommen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never arrived"
          }
        }
