          "stringUnit" : {
            "state" : "translated",
            "value" : "from %@"
          }
        }
      }
    },
    "just now" : {
      "comment" : "Age of something that happened less than a minute ago. Short: it sits in a row of small print, after a dot.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gerade eben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "just now"
          }
        }
      }
    },
    "recently" : {
      "comment" : "Stands in for how long ago a device joined, when the time is not known. Fits after \"It joined\" in a sentence.",
