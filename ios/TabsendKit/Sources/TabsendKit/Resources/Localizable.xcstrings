        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent to %@"
          }
        }
      }
    },
    "Sent to %@. Opens when it wakes" : {
      "comment" : "Share-sheet confirmation when the receiving device is asleep and will open the tab when it wakes. %@ is the name of the receiving device. Keep it short: it is a toast.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
