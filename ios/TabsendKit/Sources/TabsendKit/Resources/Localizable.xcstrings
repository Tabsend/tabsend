          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismiss"
          }
        }
      }
    },
    "Enter the relay address." : {
      "comment" : "Message on the move-to-another-relay sheet when Check is pressed with an empty field.",
      "localizations" : {
        "de" : {
