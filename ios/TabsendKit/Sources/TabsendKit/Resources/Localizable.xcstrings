    },
    "Your relay is having trouble right now. The tab is held here and sends itself once the relay is answering properly again." : {
      "comment" : "Explanation under a waiting send: the relay answered with a server error. The relay is the server that passes tabs between devices.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hat gerade Probleme. Der Tab bleibt hier und wird automatisch gesendet, sobald das Relay wieder richtig antwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay is having trouble right now. The tab is held here and sends itself once the relay is answering properly again."
          }
        }
      }
    },
    "Your relay is holding as much as your group's limit allows. This tab is queued and will send once the receiving device catches up." : {
      "comment" : "Explanation under a waiting send: the relay holds the most it may for this group. The tab goes when the receiving device collects what is already waiting. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay hält so viel zurück, wie das Limit deiner Gruppe erlaubt. Dieser Tab steht in der Warteschlange und wird gesendet, sobald das empfangende Gerät alles Wartende abgeholt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay is holding as much as your group's limit allows. This tab is queued and will send once the receiving device catches up."
          }
        }
      }
    },
    "Your relay is pacing sends for your group right now. This tab is queued and will send itself shortly." : {
      "comment" : "Explanation under a waiting send: the relay limits how fast this group may send. The wait clears within about a minute. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Relay bremst gerade das Senden für deine Gruppe. Dieser Tab steht in der Warteschlange und wird in Kürze automatisch gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your relay is pacing sends for your group right now. This tab is queued and will send itself shortly."
          }
        }
      }
    },
    "Your relay no longer accepts this phone. Set Tabsend up again here." : {
      "comment" : "Explanation after a request failed: the relay does not accept this phone's credentials. Setting up again means pairing again. The relay is the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
