{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nWebsite images load from linked sites, which can see requests from this device." : {
      "comment" : "Footer of the History screen. %@ is the sentence saying how far back the list goes. Shown only while website images are on.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nWebsite-Bilder werden von verlinkten Websites geladen. Diese sehen Anfragen von diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nWebsite images load from linked sites, which can see requests from this device."
          }
        }
      }
    },
    "%@ · %@ · %@" : {
      "comment" : "Heading of a block of tabs that were sent together, on the History screen. The first %@ is how many tabs (\"3 tabs\"), the second is who moved them (\"from Work laptop\"), the third is how long ago (\"3m ago\"). The dots separate the three.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "About %@" : {
      "comment" : "Spoken label of the info icon beside a Privacy switch. %@ is the name of the switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Info zu %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About %@"
          }
        }
      }
    },
    "Account" : {
      "comment" : "Heading of the Account group in Settings on the home screen. It holds Manage account and Delete account. Shown on the US App Store only. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account"
          }
        }
      }
    },
    "Add a device" : {
      "comment" : "Button on the home screen, and title of the sheet that shows a QR code. A device is a browser or phone that joins the group. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerät hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a device"
          }
        }
      }
    },
    "Add your computer or another phone to send your first link." : {
      "comment" : "Small line under the Your devices list on the home screen while this phone is the only device in the group. Tells a newcomer what to do next. A device is a browser or phone that joins the group.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen Computer oder ein anderes Smartphone hinzu, um deinen ersten Link zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your computer or another phone to send your first link."
          }
        }
      }
    },
    "Camera unavailable.\nAllow camera access in Settings, or paste the setup link instead." : {
      "comment" : "Centered message on the QR scanner when the camera cannot be used. Two lines: the second starts after a line break. Settings is the iOS Settings app. A setup link is the pairing link another device shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera nicht verfügbar.\nErlaube den Kamerazugriff in den Einstellungen oder füge stattdessen den Einrichtungslink ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera unavailable.\nAllow camera access in Settings, or paste the setup link instead."
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button that closes a dialog or sheet without doing anything. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbrechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Choose the name your other devices will see." : {
      "comment" : "Line under the title of the Name this phone screen. The name is how this phone appears in the device list on the person's other devices.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Namen, den deine anderen Geräte sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the name your other devices will see."
          }
        }
      }
    },
    "Close" : {
      "comment" : "Button that closes the sheet showing the QR code. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        }
      }
    },
    "Continue on tabsend.org" : {
      "comment" : "Button in the Delete account confirmation. It opens the account website (tabsend.org) in a sheet inside the app, where the deletion is finished. Keep the web address unchanged. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter auf tabsend.org"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue on tabsend.org"
          }
        }
      }
    },
    "Copy link" : {
      "comment" : "Row on the Add a device sheet. Copies the pairing link to the clipboard so it can be pasted into another browser.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link kopieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy link"
          }
        }
      }
    },
    "Couldn't reach Tabsend's service. Check your connection, then open the link in your email again." : {
      "comment" : "Banner on the first-run screen when the app could not reach Tabsend's own hosted service to finish setting up an account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tabsend-Dienst ist nicht erreichbar. Prüfe deine Verbindung und öffne dann den Link in deiner E-Mail erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach Tabsend's service. Check your connection, then open the link in your email again."
          }
        }
      }
    },
    "Couldn't reach the relay. Check the URL and that your phone is on the same network." : {
      "comment" : "Banner on the first-run screen when pairing could not reach the relay (the server that passes tabs between devices). URL is the address in the setup link.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relay nicht erreichbar. Prüfe die URL und ob dein Smartphone im selben Netzwerk ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the relay. Check the URL and that your phone is on the same network."
          }
        }
      }
    },
    "Delete account" : {
      "comment" : "Row in the Account group in Settings. Starts deleting the person's Tabsend account. Shown in red. Two words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        }
      }
    },
    "Delete your account?" : {
      "comment" : "Title of the confirmation that opens when Delete account is tapped. A question.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your account?"
          }
        }
      }
    },
    "Don't load website images" : {
      "comment" : "Settings, Privacy section: label of a switch, off by default. On means no pictures are fetched from websites; each tab shows its site's first letter.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Website-Bilder nicht laden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't load website images"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Button that closes the info sheet of a Privacy switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "Earlier" : {
      "comment" : "Heading above History rows older than yesterday. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Früher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earlier"
          }
        }
      }
    },
    "Enter a complete setup link." : {
      "comment" : "Banner on the first-run screen when Join is pressed and the pasted setup link cannot be read. A setup link is the pairing link another device shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen vollständigen Einrichtungslink ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a complete setup link."
          }
        }
      }
    },
    "History" : {
      "comment" : "Row on the home screen and title of the screen that lists every tab the group sent and received. One word if possible.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History"
          }
        }
      }
    },
    "Home" : {
      "comment" : "Bottom tab: the first screen, with the latest tabs and the devices. Short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home"
          }
        }
      }
    },
    "How pairing works" : {
      "comment" : "Small button on the first-run screen, and title of the alert it opens.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So funktioniert die Kopplung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How pairing works"
          }
        }
      }
    },
    "In a browser, or on a phone that's already paired, open Tabsend and show a code." : {
      "comment" : "Step 1 in the \"How pairing works\" sheet on the first-run screen. \"A code\" is the pairing code (a QR code with a setup link) that Tabsend shows when you add a device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Tabsend in einem Browser oder auf einem bereits gekoppelten Smartphone und zeige einen Code an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a browser, or on a phone that's already paired, open Tabsend and show a code."
          }
        }
      }
    },
    "Joining" : {
      "comment" : "Spoken description (VoiceOver) of the spinner shown on the Join button while pairing is in progress.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beitritt läuft"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining"
          }
        }
      }
    },
    "Latest" : {
      "comment" : "Section heading on Home above the cards for the newest tabs. Short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neueste"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latest"
          }
        }
      }
    },
    "Learn more about setting up Tabsend's service at tabsend.org." : {
      "comment" : "Small plain-text line at the bottom of the first-run screen on every App Store except the US one. It is not a link or a button, and it names no price, on purpose (Apple's rules, docs/PLANS.md P-25). \"Tabsend's service\" is the hosted plan, the same words as on the US screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr zur Einrichtung des Tabsend-Dienstes auf tabsend.org."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn more about setting up Tabsend's service at tabsend.org."
          }
        }
      }
    },
    "Linked" : {
      "comment" : "Banner after pairing succeeded. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linked"
          }
        }
      }
    },
    "Manage account" : {
      "comment" : "Row in the Account group in Settings. Opens the account page on the Tabsend website in a sheet inside the app. Two words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto verwalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage account"
          }
        }
      }
    },
    "NEW_LINK" : {
      "comment" : "Notification text when a link arrived but Tabsend could not fetch it in time to show its title and address, for example on a phone not unlocked since it restarted. Opening Tabsend shows the link.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuer Link"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New link"
          }
        }
      }
    },
    "Name" : {
      "comment" : "Placeholder in the text field of the Rename dialog, and the label of the name field on the Name this phone screen. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name"
          }
        }
      }
    },
    "Name this device" : {
      "comment" : "Label above the name field on the first-run screen, and its spoken description. The device is this phone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name für dieses Gerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name this device"
          }
        }
      }
    },
    "Name this phone" : {
      "comment" : "Title of the screen shown after the account's email link hands the phone back to the app. It asks for the name this phone will have in the group. Large type; may wrap onto two lines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Smartphone benennen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name this phone"
          }
        }
      }
    },
    "New" : {
      "comment" : "Small label on a History row for a received tab that has not been opened yet. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New"
          }
        }
      }
    },
    "New to Tabsend?" : {
      "comment" : "Small heading above the Set up an account button on the first-run screen. A question; shown on the US App Store only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu bei Tabsend?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New to Tabsend?"
          }
        }
      }
    },
    "No other devices yet." : {
      "comment" : "Line in the Your devices list when no other device has joined the group.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine anderen Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No other devices yet."
          }
        }
      }
    },
    "Nothing here yet. Tabs you send and tabs that arrive both show up on this screen, so a swiped notification or a closed tab doesn't lose one." : {
      "comment" : "Message on the empty History screen. Explains what will appear here.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts hier. Gesendete und angekommene Tabs erscheinen beide auf diesem Bildschirm. So geht keiner verloren, selbst wenn du eine Mitteilung wegwischst oder einen Tab schließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here yet. Tabs you send and tabs that arrive both show up on this screen, so a swiped notification or a closed tab doesn't lose one."
          }
        }
      }
    },
    "Notifications are off for Tabsend, so this list is the only place a waiting or failed send shows up. Turn them on in Settings to be told when a tab doesn't land." : {
      "comment" : "Warning in red under the list of waiting tabs, shown when notifications are switched off. Settings is the iOS Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für Tabsend ausgeschaltet. Nur in dieser Liste siehst du, wenn ein Tab wartet oder nicht gesendet werden konnte. Schalte sie in den Einstellungen ein, um Bescheid zu bekommen, wenn ein Tab nicht ankommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off for Tabsend, so this list is the only place a waiting or failed send shows up. Turn them on in Settings to be told when a tab doesn't land."
          }
        }
      }
    },
    "Only get tabs when Tabsend is open" : {
      "comment" : "Settings, Privacy section: label of a switch, off by default. On means tabs arrive only while the app is open, because Apple is no longer asked to wake the phone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs nur empfangen, wenn Tabsend geöffnet ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only get tabs when Tabsend is open"
          }
        }
      }
    },
    "Pair it once with a browser or another phone. As soon as that's done, you can share links between these devices." : {
      "comment" : "Body text of the card on the first-run screen. Pairing means linking this phone to a browser or another phone so they can send links to each other. Two sentences.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppele es einmal mit einem Browser oder einem anderen Smartphone. Danach kannst du Links zwischen diesen Geräten teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair it once with a browser or another phone. As soon as that's done, you can share links between these devices."
          }
        }
      }
    },
    "Pair this phone" : {
      "comment" : "Main button that links this phone to the group, on the first-run screen once a setup link is filled in and on the Name this phone screen. Matches the button on Android. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Smartphone koppeln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair this phone"
          }
        }
      }
    },
    "Pairing QR code" : {
      "comment" : "Spoken description (VoiceOver) of the QR code image on the Add a device sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code zum Koppeln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing QR code"
          }
        }
      }
    },
    "Paste a setup link instead" : {
      "comment" : "Quiet button on the first-run screen. It shows a field to paste a setup link (the pairing link another device shows) instead of scanning a code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen Einrichtungslink einfügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste a setup link instead"
          }
        }
      }
    },
    "Pictures load directly from each website, so those sites can see this phone's internet address and when it asked." : {
      "comment" : "Info sheet for the switch \"Don't load website images\", first paragraph.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder werden direkt von der jeweiligen Website geladen. Diese Websites sehen deshalb die Internetadresse dieses Smartphones und den Zeitpunkt der Anfrage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures load directly from each website, so those sites can see this phone's internet address and when it asked."
          }
        }
      }
    },
    "Privacy" : {
      "comment" : "Section heading in Settings above the switches for delivery and website images.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        }
      }
    },
    "Refresh" : {
      "comment" : "Row in Settings that checks the relay and the device list again. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refresh"
          }
        }
      }
    },
    "Relay" : {
      "comment" : "Section heading in Settings above the relay's address. A relay is the server that passes tabs between devices.",
