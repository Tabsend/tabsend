    "Rename this device" : {
      "comment" : "Row in Settings, and title of its dialog. Changes the name of this phone in the group.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät umbenennen"
