    "Scan code" : {
      "comment" : "Main button on the first-run screen. Opens the camera to scan a pairing QR code. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code scannen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan code"
          }
        }
      }
    },
    "Scan the code here, or paste its setup link." : {
      "comment" : "Step 2 in the \"How pairing works\" sheet on the first-run screen. \"Here\" is this phone. A setup link is the pairing link another device shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code hier oder füge seinen Einrichtungslink ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code here, or paste its setup link."
          }
        }
      }
    },
    "Scan with a phone's camera, or open the link in another browser. If Tabsend isn't installed there yet, the link shows how to install it. It works once and expires in 10 minutes." : {
      "comment" : "Note under the QR code on the Add a device sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera eines Smartphones oder öffne den Link in einem anderen Browser. Ist Tabsend dort noch nicht installiert, zeigt der Link, wie das geht. Er funktioniert nur einmal und läuft nach 10 Minuten ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan with a phone's camera, or open the link in another browser. If Tabsend isn't installed there yet, the link shows how to install it. It works once and expires in 10 minutes."
          }
        }
      }
    },
    "See all" : {
      "comment" : "Button beside the Latest heading on Home: opens the History tab. Short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anzeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See all"
          }
        }
      }
    },
    "Send again" : {
      "comment" : "Small button on a History row for a tab that never arrived. It sends the tab again to the same device. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut senden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send again"
          }
        }
      }
    },
    "Send links to this phone" : {
      "comment" : "Headline of the card on the first-run screen, in large type. May wrap onto two lines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links an dieses Smartphone senden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send links to this phone"
          }
        }
      }
    },
    "Set up an account" : {
      "comment" : "Button on the first-run screen, US App Store only. Opens the Tabsend account website in a sheet inside the app, where a new account is made. Keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto einrichten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up an account"
          }
        }
      }
    },
    "Settings" : {
      "comment" : "Heading of the section with this phone's settings on the home screen. One word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        }
      }
    },
    "Setup link" : {
      "comment" : "Label above the field where a setup link (the pairing link another device shows) is pasted, and its spoken description.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtungslink"
          }
        },
        "en" : {
