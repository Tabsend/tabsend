    },
    "Remove" : {
      "comment" : "Button next to a device in the Your devices list, and the button in its confirmation dialog. Removes the device from the group. One word if possible.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernen"
          }
        },
        "en" : {
