# Tabsend relay configuration. Copy to server/.env (or the repo-root .env for compose)
# and fill in. Every value has a safe default; Web Push keys are provisioned on boot.
# Full guide: docs/DEPLOY.md.
#
# Running a relay OTHER PEOPLE pay for? Read TABSEND_PROFILE at the bottom of this file
# first: it makes the relay check the rest of these settings for you at startup, and
# docs/HOSTED_PROFILE.md is the checklist for the parts it cannot see.

# --- Network ---------------------------------------------------------------
# Bind address. 127.0.0.1 is the safe default (reach it only via a reverse proxy);
# use 0.0.0.0 in a container or to expose on a LAN.
HOST=127.0.0.1
PORT=8787

# The PUBLIC https origin devices pair against — embedded in pairing links/QRs. Must be
# the externally reachable URL (your domain behind HTTPS), NOT the internal bind address.
# With TLS_SELF_SIGNED on, leaving this EMPTY lets the relay pick this host's best LAN
# address (real NIC > mesh VPN > docker0/virbr0 bridges) and log what it passed over. Set
# it explicitly when that guess is wrong.
PUBLIC_RELAY_URL=http://localhost:8787

# Optional browser-specific public route. Leave unset normally. With self-signed TLS
# plus HTTP_PORT, the relay derives http://<PUBLIC_RELAY_URL host>:<HTTP_PORT>
# automatically. Set this only when the browser listener uses a different public host
# or reverse-proxy path.
# PUBLIC_BROWSER_RELAY_URL=http://192.168.1.20:8786

# Set to 1/true when running behind a reverse proxy (Caddy/nginx) so the relay trusts
# X-Forwarded-For and rate-limits on the real client IP. Leave off if directly exposed.
TRUST_PROXY=0

# --- Self-signed TLS (P-3) -------------------------------------------------
# Set to 1/true to serve HTTPS directly with a locally generated self-signed cert
# (no reverse proxy, no CA). Generated ONCE on first boot, reused for 10 years —
# pairing links/QRs then carry the cert's key fingerprint so devices pin exactly
# this cert. Leave off when running plain HTTP behind a reverse proxy (default).
TLS_SELF_SIGNED=0

# Where the generated key.pem/cert.pem live. Default: a tls/ dir in the data dir.
# TLS_DIR=./.data/tls

# Extra hostnames/IPs baked into the cert alongside localhost + this host's LAN IPs
# (comma-separated). Only read the first time the cert is generated — so list every
# address you might ever serve on. Adding one later needs a NEW cert, and a new cert
# breaks the pin on every already-paired device. Boot warns if the address in
# PUBLIC_RELAY_URL is not covered by the cert on disk.
# TLS_EXTRA_SANS=relay.lan,192.168.1.20

# An ADDITIONAL plain-HTTP listener on this port, alongside the https one above.
# Browser extensions cannot pin a certificate the way the Android app does, so they
# cannot use a self-signed relay at all — this port is how they connect. Same relay:
# both listeners share the database and the live-socket registry, so delivery between
# a browser here and a phone on https is still instant.
# CLEARTEXT: device tokens are readable by anyone on the network (tab contents stay
# end-to-end encrypted). Trusted LAN only — never forward this port to the internet.
# Ignored unless TLS_SELF_SIGNED is on, and must differ from PORT.
# HTTP_PORT=8786

# By default the cleartext port REFUSES clients outside private network ranges
# (10.x, 192.168.x, 172.16–31.x, 169.254.x, 100.64–127.x for VPNs, plus IPv6
# loopback/link-local/unique-local). That way a router forwarding the port by mistake
# cannot leak device tokens to the internet. It is a seatbelt, not encryption —
# anyone already on your LAN can still read a token.
# Set to 1 only if your own network gives devices globally routable addresses (common
# with IPv6) and the guard is refusing machines you trust.
# HTTP_ALLOW_PUBLIC=0

# --- Database --------------------------------------------------------------
# SQLite (default; a file path) OR Postgres (postgres://…). Same schema/migrations both
# ways. The relay auto-migrates on boot (idempotent, additive).
DATABASE_URL=sqlite:./.data/tabsend.db
# Postgres example:
# DATABASE_URL=postgres://tabsend:PASSWORD@localhost:5432/tabsend

# --- Web Push (VAPID) ------------------------------------------------------
# Leave both key fields empty for the normal setup: first boot generates a keypair and
# stores it in the relay database, and every later boot reuses it. Database backups
# therefore preserve existing browser push subscriptions.
#
# Set BOTH only if you intentionally manage VAPID identity outside the relay database
# (for example, migrating an existing deployment). A partial pair is rejected rather
# than silently ignored. `gen:vapid` remains available to create an explicit override.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Client-supplied push URLs are restricted to public HTTPS destinations and DNS is
# re-checked when the TLS socket connects. Set this only when a self-hosted relay
# intentionally needs to reach a private UnifiedPush distributor. Never enable it
# on a multi-tenant/hosted relay.
# PUSH_ALLOW_PRIVATE_ENDPOINTS=0

# --- Waking phones (the wake-up forwarder) ----------------------------------
# Leave this unset unless you want phones to receive tabs while the app is closed.
# Unset is what every relay does today: no wake, an iPhone picks its tabs up the next
# time it is opened, and an Android phone keeps its own connection open (behind the
# permanent notification Android requires for that). Browsers are not affected.
#
# Setting it changes Android phones too, not only iPhones. An Android build with Google
# push (ADR-0034; none ships yet) then signs up with the wake-up service, closes its own
# connection and drops its permanent notification, unless its user chose "Don't use
# Google". It signs up with the forwarder built into the app, so if this relay rings a
# different one, that phone is never rung: it gets tabs only when it checks in, every few
# minutes, or when it is opened.
#
# Why it exists: iOS freezes an app the moment it goes to the background, so the only
# way to wake one is Apple's push service, and Apple takes instructions only from a key
# it issues to a paid developer account. Android can stay connected, but only behind a
# permanent notification, and Google's push service, the way around it, likewise takes
# instructions only from the app maker's credential. Those keys cannot be handed out, so
# your relay cannot ring a phone by itself however well you configure it. It asks a
# small service to ring it instead, and the phone then fetches from YOUR relay, as always.
#
# What that service learns: that a device received something, and when, and the network
# address of the relay that asked. Never what. No tab, no URL, no title, no sender, no
# account, no email. There is nowhere in the request for any of it to go: the call
# carries a token that means "ring that phone" and nothing else, and the push Apple or
# Google delivers is empty. Apple or Google sees each ring too, never its content.
#
# The project runs an instance; its address ships with the phone apps rather than being
# guessed here, so put the address you were given below. You can also run your own if
# you have an Apple developer account (or, for Android, your own Firebase project and
# your own app build), which is why the forwarder's source is published (see the
# forwarder directory in the Tabsend repository). Either way this is YOUR setting: the
# relay only ever calls the address written here, never one a device asks it to call.
#
# If it is down, or you unset it later, delivery goes back to drain-on-open. Nothing is
# lost, because your tabs were on your relay the whole time.
#
# Use https unless the forwarder runs on this same machine. The relay sends the phone's
# wake token in a header on every ring, so plain http to another host puts it on the wire
# in the clear; http://127.0.0.1:8788 (the forwarder's default port) is fine, because
# there is no wire. Point this at a forwarder and nothing else: a forwarder answers 202,
# and the relay treats every other answer as a failed ring, a redirect included, so an
# address that turns out to be a health page cannot look like a working doorbell.
#
# Each phone is rung once per send, however many tabs it carries, and not while its app
# is open and connected. The forwarder also limits each calling relay
# (CALLER_RATE_LIMIT_MAX on the forwarder, 120 a minute); raise it there for a relay that
# serves many phones, counting Android phones as well as iPhones.
#
# WAKE_FORWARDER_URL=https://wake.example.com

# --- Message lifecycle -----------------------------------------------------
# Time-to-live for queued messages (expired ciphertext is purged; expired sends are
# never delivered). Days by default; MESSAGE_TTL_SECONDS wins if set (handy for testing).
MESSAGE_TTL_DAYS=7
# MESSAGE_TTL_SECONDS=

# Pairing-code lifetime (minutes). Must be above zero.
PAIRING_CODE_TTL_MINUTES=10

# How many pairing links one group may have waiting at once: minted, not yet used, not
# yet expired. Past this, minting is refused with a message saying how long to wait. On
# by default, unlike the CAP_* limits below, because it bounds a table rather than a
# plan: a link is made to hand to a device in front of you and it expires in ten
# minutes, so nothing normal comes near 20. Set 0 to switch it off. Must be a whole
# number; anything else stops the relay at startup.
# PAIRING_CODES_MAX_LIVE=20

# TTL sweeper cadence (seconds; <=0 disables). A tombstone is hard-deleted this long
# past expiry (defaults to one TTL → total server retention ~2× TTL). Pairing links are
# deleted on the same schedule once they are past their own expiry by this long, which
# keeps "this link was already used" answerable for a while after.
SWEEP_INTERVAL_SECONDS=60
# SWEEP_GRACE_SECONDS=

# --- Hardening (Chunk 6b) --------------------------------------------------
# Max JSON request body in bytes (abuse guard). Default 1 MiB.
MAX_BODY_BYTES=1048576

# Rate limit for the UNauthenticated write route (register): max requests per window per
# client IP. Set RATE_LIMIT_MAX=0 to disable. Emits `rate_limited` (429) with Retry-After.
# The counts live in the relay database, not in memory, so if you ever run two relay
# processes against one database they share one budget instead of one each.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=600

# Consecutive 404/410 push failures before a subscription is treated as dead (wakes
# skipped until the client rotates a fresh one via heartbeat).
PUSH_DEAD_THRESHOLD=3

# WebSocket resource limits. The stream carries only hello/ping JSON, so the frame
# cap is intentionally much smaller than MAX_BODY_BYTES. Clients ping every 30 s.
STREAM_MAX_FRAME_BYTES=16384
STREAM_HELLO_TIMEOUT_SECONDS=10
STREAM_IDLE_TIMEOUT_SECONDS=90
STREAM_MAX_CONNECTIONS=1000
STREAM_MAX_CONNECTIONS_PER_ENDPOINT=5
# Per group, so one group on a shared relay cannot take every connection the process
# allows. A device turned away falls back to polling.
STREAM_MAX_CONNECTIONS_PER_GROUP=100

# --- Groups ----------------------------------------------------------------
# Who may create a group on this relay. Leave it alone unless you know you need
# something else.
#
#   single       (default) One relay, one group. The relay makes its group at startup
#                and prints a pairing link for it; every device, including phones,
#                joins with a link. A second "create" is refused, because a browser
#                that clicked create instead of join would land in an invisible second
#                group and quietly stop seeing your other devices.
#   open         Several groups, and anyone who can reach this relay may create one
#                without a link. For deliberately isolated groups on one instance.
#   provisioned  Several groups, but nobody may create one over the API, not even
#                while the relay is empty. Groups are set up by whoever runs the
#                relay, and devices only ever join with a pairing link. This is the
#                setting for a relay other people use: without it, a stranger who
#                finds the address can start their own group on your machine.
#
# GROUP_CREATION=single

# The older name for the same thing. ALLOW_MULTIPLE_GROUPS=1 still means
# GROUP_CREATION=open and keeps working. Setting both is fine only when they agree;
# a pair that contradicts each other stops the relay at startup with an explanation
# rather than picking one.
# ALLOW_MULTIPLE_GROUPS=0

# --- Per-group limits ------------------------------------------------------
# How much any ONE group may use. Every limit is 0 (unlimited) by default, which is
# the right answer for a relay you run for yourself: the person paying for the disk
# and the bandwidth is the person using it. Set them on a relay other people use, so
# one group cannot fill it for everybody else.
#
# 0 always means unlimited. A limit set here applies to every group; a single group
# can be given its own number in the database, and that wins.
#
# Devices allowed in one group. A join past this is refused with a message naming the
# number, and the pairing link is NOT used up, so it still works once somebody removes
# a device they no longer use.
# CAP_ENDPOINTS=0
#
# Tabs a group may have waiting for delivery at once, and the total encrypted size of
# them. Both only count tabs still waiting: reading a tab on the target device frees
# its space again. A tab refused for either reason is reported per tab, so sending
# five when there is room for three sends three and says so.
# CAP_QUEUED_MESSAGES=0
# CAP_QUEUED_BYTES=0
#
# How many tabs a group may send per window, across all its devices. Each new copy of
# the group's history key handed to a device counts as one as well. This one clears
# itself when the window rolls over, so it limits bursts rather than totals. History key
# copies are bounded without it too: at most 64 per device, 4096 bytes each.
# CAP_SENDS_PER_WINDOW=0
# CAP_SEND_WINDOW_SECONDS=60

# --- Provisioning API (hosted relays) ---------------------------------------
# Leave this unset unless something else on this machine sets groups up for you.
# Unset means the /admin/provisioning routes DO NOT EXIST: nothing is registered,
# and the address answers a plain 404 like any other URL the relay does not serve.
# A relay you run for yourself needs none of this.
#
# What it is for: a hosted relay where groups are created out of band
# (GROUP_CREATION=provisioned) needs something able to create a group, hand out its
# first pairing link, set its limits, read how much it is using, suspend it and
# delete it. That is what these routes do, and only for a caller on this same
# machine that also holds the credential below.
#
# Two conditions, both required. The call must come from this host, dialled
# directly (not forwarded by a reverse proxy), AND carry this credential as
# "Authorization: Bearer <credential>". Being on the machine is not enough on its
# own: it says where a caller is, not who it is, and it cannot tell your own
# software apart from anything else running there. Every failure of either
# condition answers the same 404, so nothing scanning the relay learns the routes
# are here.
#
# Generate one with:
#   openssl rand -base64 32
#
# PROVISIONING_TOKEN=

# The same credential read from a file instead, which is how a secret manager
# usually hands one over. Set this OR the variable above, never both. A trailing
# newline in the file is fine.
# PROVISIONING_TOKEN_FILE=/run/secrets/tabsend-provisioning

# --- Deployment profile (hosted relays) -------------------------------------
# Leave this unset. Unset is every relay that exists today: nothing is checked,
# nothing is warned about, and nothing behaves differently.
#
# Set it to "hosted" only on a multi-tenant relay other people pay to use. It does
# not switch anything on. It is a claim about the deployment, and the relay checks
# the claim at startup and REFUSES TO START if the settings above are not what a
# hosted relay's settings should be:
#
#   PUSH_ALLOW_PRIVATE_ENDPOINTS   off
#   GROUP_CREATION                 provisioned
#   PROVISIONING_TOKEN(_FILE)      set, so a tenancy can be created at all
#   DATABASE_URL                   a postgres:// URL
#   TLS_SELF_SIGNED                off (a hosted relay has a real certificate)
#   TRUST_PROXY                    on (it sits behind a proxy)
#   RATE_LIMIT_MAX                 above 0
#   SWEEP_INTERVAL_SECONDS         above 0
#   PUBLIC_RELAY_URL               an explicit https origin
#
# Refusing rather than warning, because a paid relay that quietly runs in a weaker
# posture than its operator believes is taking money for nothing. Anything wrong is
# listed at startup with the variable to change and what to change it to, all of it
# at once, so one restart clears the lot.
#
# What it CANNOT check: the network firewall denying private and cloud-metadata
# egress, the separate system users, the per-service database grants, and where the
# secrets came from. Those are real requirements with no way for the relay to see
# them, and docs/HOSTED_PROFILE.md is the checklist, with a verification command for
# each one.
#
# TABSEND_PROFILE=hosted
