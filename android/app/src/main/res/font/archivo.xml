<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo, static instances (docs/APP_UI.md "Type"). minSdk is 26, where font
     families in XML are native, so the android: attributes are what the platform
     reads; the app: copies are for AppCompat's own font loading, which reads
     those instead. Weight-specific text (titles 800, row titles 600) references
     the single files directly, e.g. @font/archivo_extrabold, because selecting a
     weight from a family by number needs API 28 (textFontWeight). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/archivo_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/archivo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/archivo_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/archivo_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/archivo_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/archivo_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/archivo_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/archivo_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
