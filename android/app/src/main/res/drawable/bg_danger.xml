<?xml version="1.0" encoding="utf-8"?>
<!-- Red panel for the "reset pending" card (P-18 item 12). The same shape as
     bg_warning (radius 16, a 1dp frame), tinted with the danger red: this notice
     ends with every device removed unless someone stops it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/danger_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/danger_stroke" />
    <corners android:radius="16dp" />
</shape>
