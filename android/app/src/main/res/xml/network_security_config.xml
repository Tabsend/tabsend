<?xml version="1.0" encoding="utf-8"?>
<!-- Https-only (DEPLOY.md: real relays must sit behind TLS). This is the release
     build's file, the one Google Play gets. The debug build, which is what the GitHub
     APKs are, overrides it with src/debug/res/xml/network_security_config.xml, which
     also allows plain http to loopback for the local-relay test drive. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
