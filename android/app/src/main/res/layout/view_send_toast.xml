<?xml version="1.0" encoding="utf-8"?>
<!--
  The send feedback in its Android form (docs/APP_UI.md "Phones: native-leaning",
  "Send feedback"): a bar styled as a Material 3 snackbar — inverse surface, 4dp
  corners, a soft elevation shadow, a status icon, the text, and at most one
  action — anchored to the bottom of the share sheet's own translucent window,
  over the app the user shared from.

  Not a real Snackbar: that needs a CoordinatorLayout or a content view to attach
  to, runs its own show/dismiss timers and swipe handling, and would have to be
  rebuilt for each state. This bar is updated in place from "Sending…" to the
  outcome, and ShareActivity keeps sole control of when the window closes (its
  accessibility-stretched timer, a tap outside, Back, or the close button).

  The root fills the window so a tap anywhere outside the bar dismisses it. The
  bar itself is a polite live region: a screen reader hears "Sending to X" and
  then the outcome, without focus being moved.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toastRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/toastCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_snackbar"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <!-- 24dp status slot: the spinner while sending, then the round status icon. -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="noHideDescendants">

            <ProgressBar
                android:id="@+id/toastProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ts_inverse_primary" />

            <ImageView
                android:id="@+id/toastIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/toastHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/ts_on_inverse_surface" />

            <!-- The second line where a state has one: the tab's name, "Opens
                 there when it wakes", or the reason it didn't go. -->
            <TextView
                android:id="@+id/toastDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/ts_on_inverse_muted"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The one action: "View" after a send (opens History). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toastAction"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:textColor="@color/ts_inverse_primary"
            android:visibility="gone"
            app:rippleColor="@color/ts_on_inverse_muted" />

        <!-- Close, on the states that stay until dismissed. -->
        <ImageButton
            android:id="@+id/toastClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send_toast_close"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            app:tint="@color/ts_on_inverse_surface"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
