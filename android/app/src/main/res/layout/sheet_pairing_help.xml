<?xml version="1.0" encoding="utf-8"?>
<!-- "How pairing works" (first screen): a short Material bottom sheet, the same three lines as the
     iPhone's sheet. It replaces a long alert that talked about the relay and encryption. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/pairingHelpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:accessibilityHeading="true"
        android:text="@string/pairing_how"
        android:textAppearance="@style/TextAppearance.Tabsend.SheetTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_step_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/pairing_help_number_1"
            android:textColor="@color/ts_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:paddingTop="3dp"
            android:text="@string/pairing_help_step_1"
            android:textAppearance="@style/TextAppearance.Tabsend.PairingBody" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_step_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/pairing_help_number_2"
            android:textColor="@color/ts_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:paddingTop="3dp"
            android:text="@string/pairing_help_step_2"
            android:textAppearance="@style/TextAppearance.Tabsend.PairingBody" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_step_badge"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/ts_on_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:paddingTop="3dp"
            android:text="@string/pairing_help_step_3"
            android:textAppearance="@style/TextAppearance.Tabsend.PairingBody" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pairingHelpClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="@string/pair_close" />
</LinearLayout>
