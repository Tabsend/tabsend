{
  "manifest_version": 3,
  "name": "Tabsend",
  "version": "0.1.0",
  "description": "Send the tab you're looking at to your phone or another computer. One click, end-to-end encrypted.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabsend@tabsend.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/tabsend-16.png",
    "32": "icons/tabsend-32.png",
    "48": "icons/tabsend-48.png",
    "128": "icons/tabsend-128.png"
  },
  "action": {
    "default_popup": "chooser.html",
    "default_title": "Tabsend — send this tab",
    "default_icon": {
      "16": "icons/tabsend-16.png",
      "32": "icons/tabsend-32.png",
      "48": "icons/tabsend-48.png",
      "128": "icons/tabsend-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Do what clicking the Tabsend icon does"
    },
    "send-to-primary": {
      "description": "Send this tab in one click to your “Send to” device (4 seconds to undo)"
    }
  },
  "permissions": ["tabs", "storage", "contextMenus", "alarms", "scripting", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
